{
    "name": "player",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "format": "prettier --write \"src/**/*.svelte\" \"src/**/*.html\" \"src/**/*.ts\" \"src/**/*.scss\" \"tests/**/*.mjs\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.json\" \"*.ts\" \"*.md\"",
        "format:check": "prettier --check \"src/**/*.svelte\" \"src/**/*.html\" \"src/**/*.ts\" \"src/**/*.scss\" \"tests/**/*.mjs\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.json\" \"*.ts\" \"*.md\"",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "node --test tests/*.test.mjs",
        "test:browser": "playwright test",
        "visual:dashboard": "node scripts/capture-dashboard.mjs"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@sveltejs/adapter-auto": "^8.0.0",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "sass": "^1.106.1",
        "svelte": "^5.57.1",
        "svelte-check": "^4.6.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.0"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
