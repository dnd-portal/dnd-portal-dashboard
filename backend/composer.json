{
    "name": "dnd-portal/backend",
    "type": "project",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "scripts": {
        "format": "php-cs-fixer fix --config=.php-cs-fixer.php scripts/account_migration_proposal.php scripts/account_migration_import.php scripts/migrate.php tests/integration/account_migration_import.php",
        "format:check": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff scripts/account_migration_proposal.php scripts/account_migration_import.php scripts/migrate.php tests/integration/account_migration_import.php"
    }
}
