{
    "name": "dnd-portal/backend",
    "type": "project",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpmyadmin/sql-parser": "5.10"
    },
    "scripts": {
        "format": "php-cs-fixer fix --config=.php-cs-fixer.php --using-cache=no && php tools/format_pipeline.php",
        "format:check": "php-cs-fixer fix --config=.php-cs-fixer.php --using-cache=no --dry-run --diff && php tools/format_pipeline.php --check"
    }
}
